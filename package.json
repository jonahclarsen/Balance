{
  "name": "balance",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.13.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:tauri": "tauri dev",
    "build": "vite build && node scripts/build-macos-widget.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test:unit": "playwright test --config playwright.unit.config.ts",
    "test:relay": "node --test scripts/relay-server.test.mjs relay-worker/src/index.test.js",
    "profile:relay-empty-poll": "node scripts/profile-empty-relay-poll.mjs",
    "test:interaction-performance": "playwright test --config playwright.interaction-performance.config.ts",
    "test:theme-performance": "playwright test --config playwright.theme-performance.config.ts",
    "profile:mobile-drawer": "playwright test --config playwright.mobile-drawer-performance.config.ts",
    "test:undo-performance": "cargo test --manifest-path src-tauri/Cargo.toml tests::undo_performance_profile -- --exact --ignored --nocapture && playwright test --config playwright.undo-performance.config.ts",
    "test:visual": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2.11.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.12.3",
    "@types/qrcode": "^1.5.6",
    "pngjs": "5.0.0",
    "svelte": "^5.55.5",
    "svelte-check": "^4.4.8",
    "typescript": "~6.0.2",
    "vite": "^8.0.12"
  },
  "dependencies": {
    "@jsquash/webp": "1.5.0",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-barcode-scanner": "^2.1.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-haptics": "^2.3.2",
    "qrcode": "^1.5.4"
  }
}
